# =================================================
# Basic
# =================================================

font-family = FiraCode Nerd Font
font-feature = -calt, -liga, -dlig

copy-on-select = clipboard


# Visible separator between split panes
split-divider-color = #45475a

# =================================================
# Color Scheme
# =================================================
theme = Monokai Classic
cursor-color = c0c1b5


# =================================================
# Key Bind
# =================================================
# keybindings
keybind = ctrl+g>r=reload_config

keybind = ctrl+g>n=new_window

# tabs
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u

keybind = ctrl+g>n=new_tab
keybind = performable:alt+tab=next_tab
keybind = performable:alt+shift+tab=previous_tab
keybind = ctrl+g>c=close_surface

# quick tab switch
keybind = ctrl+g>1=goto_tab:1
keybind = ctrl+g>2=goto_tab:2
keybind = ctrl+g>3=goto_tab:3
keybind = ctrl+g>4=goto_tab:4
keybind = ctrl+g>5=goto_tab:5
keybind = ctrl+g>6=goto_tab:6
keybind = ctrl+g>7=goto_tab:7
keybind = ctrl+g>8=goto_tab:8
keybind = ctrl+g>9=goto_tab:9

# split
keybind = ctrl+g>v=new_split:right
keybind = ctrl+g>shift+v=new_split:left
keybind = ctrl+g>h=new_split:down
keybind = ctrl+g>shift+h=new_split:up

keybind = performable:ctrl+j=goto_split:bottom
keybind = performable:ctrl+k=goto_split:top
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+l=goto_split:right


keybind = ctrl+up=resize_split:up,50
keybind = ctrl+down=resize_split:down,50
keybind = ctrl+left=resize_split:left,50
keybind = ctrl+right=resize_split:right,50


